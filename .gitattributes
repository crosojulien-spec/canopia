# Keep the preparation package byte-for-byte identical to its manifest.
* -text

# Normalize future application source files only.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

*.docx binary
*.pdf binary
*.png binary
*.jpg binary
