# Local preparation. No outgoing AI or email calls by default.
PORT=4310
HOST=127.0.0.1
CANOPIA_ORIGIN=http://127.0.0.1:4310
CANOPIA_AI_MODE=disabled
CANOPIA_ALLOW_AI_CALLS=false
# Initial trial cap; activation requires explicit authorisation. Never reset the ledger to refill it.
CANOPIA_AI_BUDGET_USD=0
OPENAI_API_KEY=
OPENAI_MODEL=
CANOPIA_EMAIL_MODE=preview
CANOPIA_ALLOW_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CANOPIA_EMAIL_FROM=
CANOPIA_TEST_RECIPIENTS=
# Optional existing PostgreSQL service; unset uses PGlite in .local/postgres.
DATABASE_URL=
# Required for an eventual hosted deployment; never commit a real value.
CANOPIA_SECRET=
# Real stays are blocked in this build pending an agreed, implemented data policy.
CANOPIA_ALLOW_REAL_STAYS=false
# These values are local demo defaults, not a validated real-guest policy.
CANOPIA_GUEST_LINK_DAYS=7
# Reserved for the future agreed policy; no automatic deletion is implemented yet.
CANOPIA_RETENTION_DAYS=
